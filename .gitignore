# Build materials - these stay on John's computer, never published.
# Everything here is rebuilt by `python run_all.py`.

# Downloaded source data (121 MB) - re-downloadable from GovInfo, the House
# Clerk, the Senate, GitHub and the Census Bureau.
billstatus_cache/
rollcall_cache/
photo_cache/
profile_cache/
district_cache/

# The database and workbook the build produces (110 MB).
*.sqlite
*.sqlite-journal
*.xlsx

# The private Python environment (34 MB) - recreated on first run.
.venv/
__pycache__/
*.pyc

# Run logs and the offline smoke-test output.
logs/
smoke/

# The build writes the site here; `docs/` holds the published copy.
site/

# Working files from the optional rating step.
review.md
ratings_export.json

# Screenshots and notes for Claude Code. Never published, never uploaded to
# GitHub - these stay on this computer only.
zz_screenshots/
fec_cache/
legiscan_key.txt
fec_key.txt
states_cache/

# On The Ballot's downloaded candidate lists (some carry candidates' addresses and phone numbers; never published).
ballot_cache/

# Election Night: downloads and database side files stay on this computer
election_cache/
*.sqlite-shm
*.sqlite-wal
# Election Night: the copy of the live figures that is pushed to the live repository (a git repository of its own),
# and the status file the updater rewrites every few minutes
election_live/
election_night_status.md

# Stray error output from a shell redirect that a Windows path broke (files named C or x at the root)
/C
/x
