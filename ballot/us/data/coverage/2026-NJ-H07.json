ps://bsky.app/profile/did:plc:22oij6txozv3f457fuhedgdy/post/3mzgwjhuph22o"},{"x":"Westfield is fired up and ready to flip this seat!","w":"Rebecca Bennett","wk":"candidate","pf":"bluesky","t":"2026-11-03T19:51:16Z","u":"https://bsky.app/profile/did:plc:22oij6txozv3f457fuhedgdy/post/3mzgmeygsq222"},{"x":"Quick stop at Rock n’ Joe in Westfield before heading back out on the doors!","w":"Rebecca Bennett","wk":"candidate","pf":"bluesky","t":"2026-11-03T18:05:48Z","u":"https://bsky.app/profile/did:plc:22oij6txozv3f457fuhedgdy/post/3mzggifrmlk2r"},{"x":"Just like the missions I flew in the Navy, this campaign has always been about the team. I am so grateful to the people from across New Jersey who have given their time and support to this campaign. Let’s go win this!","w":"Rebecca Bennett","wk":"candidate","pf":"bluesky","t":"2026-11-03T14:19:36Z","u":"https://bsky.app/profile/did:plc:22oij6txozv3f457fuhedgdy/post/3mzfztwbm2k2n"}]},"ck":"2026-11-08"}