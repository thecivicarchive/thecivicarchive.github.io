# These three files are generated by the build. Normalise them to LF inside the
# repository so a rebuild with unchanged content produces an unchanged commit,
# whatever line endings Windows happens to emit. Without this, each weekly
# publish would register the whole 10 MB file as changed.
docs/index.html text eol=lf
us_districts_albers.json text eol=lf
us_states_albers.json text eol=lf
